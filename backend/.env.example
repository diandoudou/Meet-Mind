# Backend Environment Variables

# Gemini AI API (backend only — do NOT put in frontend/.env)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL_NAME="gemini-3.6-flash"

# RAG Configuration
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=8
# Chunking: semantic (LangChain SemanticChunker) | fixed
RAG_CHUNK_STRATEGY=semantic
RAG_SEMANTIC_BREAKPOINT=percentile
RAG_SEMANTIC_MAX_CHARS=1536
# Vector backend: chroma (default) | milvus
RAG_VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
# Milvus Lite local file (used when RAG_VECTOR_STORE=milvus)
MILVUS_URI=./data/milvus/meetmind.db
MILVUS_COLLECTION=meetmind_chunks_v2
# Chinese-CLIP (中文 CLIP) for image_vector
CHINESE_CLIP_MODEL=OFA-Sys/chinese-clip-vit-base-patch16
# CHINESE_CLIP_DEVICE=cpu

# DashScope API (Alibaba Cloud)
# Get from https://dashscope.aliyun.com/
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_ASR_MODEL_NAME="paraformer-realtime-v2"

# Optional: Custom wake-up keyword
WAKE_UP_KEYWORD="MeetMind"

# Meeting audio persistence + offline diarization (WhisperX + pyannote)
MEETING_AUDIO_PERSIST=true
MEETING_AUDIO_DIR=./data/meeting_audio
DIARIZATION_OFFLINE_ENABLED=true
DIARIZATION_DEVICE=cpu
# DIARIZATION_MIN_SPEAKERS=2
# DIARIZATION_MAX_SPEAKERS=6
WHISPERX_MODEL=base
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_BATCH_SIZE=8
# Hugging Face token required for pyannote speaker-diarization models
HF_TOKEN=hf_xxx
